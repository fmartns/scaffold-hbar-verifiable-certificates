    "@credo-ts/hedera": "0.7.2",
    "@credo-ts/node": "0.7.2",
    "@hashgraph/sdk": "^2.81.0",
    "@hyperledger/anoncreds-nodejs": "^0.4.1",
    "@openwallet-foundation/askar-nodejs": "^0.6.1",
    "@sh/sdk": "workspace:*",
    "next": "^15.2.8",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "server-only": "^0.0.1",
    "zstd-napi": "^0.0.13"
