{
  "name": "@sh/nextjs",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "next build",
    "check-types": "tsc --noEmit --incremental",
    "coverage": "vitest run --coverage",
    "dev": "next dev",
    "format": "prettier --write . '!(node_modules|.next)/**/*'",
    "lint": "eslint . --max-warnings=0",
    "lint-staged": "eslint --max-warnings=0 --no-warn-ignored",
    "serve": "next start",
    "start": "next dev",
    "test": "vitest run"
  },
  "dependencies": {
    "@credo-ts/anoncreds": "0.7.2",
    "@credo-ts/askar": "0.7.2",
