{
  "name": "@sh/sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AnonCreds certificates on Hedera: Credo agents, the Hedera Verifiable Data Registry, HCS-1 documents and the PDF renderer. Consumed as TypeScript source by the Next.js app.",
  "main": "index.ts",
  "types": "index.ts",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "coverage": "vitest run --coverage",
    "format": "prettier --write './**/*.ts'",
    "lint": "eslint --max-warnings=0",
    "lint-staged": "eslint --no-warn-ignored",
    "setup": "tsx cli/setup.ts",
    "test": "vitest run",
    "issuer:init": "tsx cli/issuer-init.ts"
  },
  "devDependencies": {
    "@hiero-did-sdk/hcs": "^0.1.8",
    "@types/node": "^20.19.8",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "~8.27.0",
    "@typescript-eslint/parser": "~8.27.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "~9.23.0",
    "eslint-config-prettier": "~10.1.1",
    "eslint-plugin-prettier": "~5.2.4",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@credo-ts/anoncreds": "0.7.2",
    "@credo-ts/askar": "0.7.2",
    "@credo-ts/core": "0.7.2",
    "@credo-ts/hedera": "0.7.2",
    "@credo-ts/node": "0.7.2",
    "@hashgraph/sdk": "^2.81.0",
    "@hyperledger/anoncreds-nodejs": "^0.4.1",
    "@openwallet-foundation/askar-nodejs": "^0.6.1",
    "ethers": "^6.14.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "zstd-napi": "^0.0.13"
  }
}
