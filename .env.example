# Network the app targets: testnet, mainnet or local. Defaults to testnet when empty.
HEDERA_NETWORK=

# JSON-RPC relay URL for the selected network. Empty uses the public Hashio endpoint, which is for development and testing only.
HEDERA_RPC_URL=

# Mirror Node REST URL for the selected network. Empty uses the public Hedera Mirror Node.
HEDERA_MIRROR_NODE_URL=

# Server-side operator account ID (0.0.x) that publishes HCS messages and manages HTS. Required by yarn setup.
HEDERA_OPERATOR_ID=

# Private key of the operator account (hex). Required by yarn setup. Secret: never commit it and never expose it to the browser.
HEDERA_OPERATOR_KEY=

# Minimum operator balance in HBAR that yarn setup requires. Empty uses the default for the selected network (20 on testnet, 10 on mainnet).
HEDERA_MIN_BALANCE_HBAR=

# ID (0.0.x) of the HCS topic that receives the settlement evidence. Create it on the selected network with a submitKey equal to the operator key. Required by the HCS publisher.
HEDERA_HCS_TOPIC_ID=

# EVM address of the deployed SettlementRouter. It binds every published attestation (EIP-712 domain) to that deployment. Required by the HCS publisher.
HEDERA_SETTLEMENT_ROUTER_ADDRESS=

# Overall deadline of one HCS publish in milliseconds (1000 to 120000). Empty uses 30000.
HEDERA_HCS_PUBLISH_TIMEOUT_MS=

# EVM address of the deployed CredentialRegistry. Source of truth for credential status and the EIP-712 domain of credential evidence. Required by the credential audit.
HEDERA_CREDENTIAL_REGISTRY_ADDRESS=

# How long the credential audit keeps polling the Mirror Node for data that is not indexed yet, in milliseconds (0 to 300000). Empty uses 20000.
HEDERA_AUDIT_POLL_TIMEOUT_MS=

# ID (0.0.x) of the HTS token that represents the settled asset (not a generic ERC-20). Required by the HTS adapter.
HEDERA_HTS_TOKEN_ID=

# How a settlement credits the beneficiary: mint-transfer (ADR v1: mint the amount, then transfer it) or pool-transfer (transfer from a pre-funded treasury). Empty uses mint-transfer.
HEDERA_HTS_SETTLEMENT_MODEL=

# Who holds the token's treasury and keys: router (production, ADR v1: the SettlementRouter mints and transfers on-chain) or operator (development and Testnet only: the operator account does). Empty uses router. Refused on mainnet.
HEDERA_HTS_CUSTODY=

# Treasury account (0.0.x) for operator custody. Empty uses the operator account.
HEDERA_HTS_TREASURY_ID=

# Encrypted deployer key written by the account script. Do not fill it manually.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# Base URL of the oracle provider.
ORACLE_BASE_URL=

# Which oracle provider to use: mock (default; deterministic, no credentials, for tests/dev/CI) or a real provider name registered by issue #23. Never selects a real provider by itself.
ORACLE_PROVIDER=

# Deadline of one oracle fetch, in milliseconds. Empty uses 10000.
ORACLE_TIMEOUT_MS=

# Oracle-side freshness precheck: an observation older than this is rejected before signing. Empty uses 300 (ADR-001 maxAge starting point).
ORACLE_MAX_AGE_SECONDS=

# Default attestation lifetime from observedAt, when a caller does not specify one. Empty uses 900 (ADR-001 maxValidity starting point).
ORACLE_VALIDITY_SECONDS=

# API key of the oracle provider, when the provider requires one.
ORACLE_API_KEY=
