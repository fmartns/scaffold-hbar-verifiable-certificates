# dependencies
node_modules

# yarn (the pinned release in .yarn/releases is part of the template)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# env files: only the example is versioned
.env
.env.*
!.env.example

# key material and secret-scan reports
*.pem
*.key
*.p12
*.pfx
*.keystore
keystore.json
gitleaks-report*.json

# eslint
.eslintcache

# misc
.DS_Store

# IDE
.vscode
.idea

# local AI coding assistant state (worktrees, scratch files)
.claude/
.cursor/

# hedera-harness: run artifacts, vendored skills and caches (the recipe in .harness/ is versioned)
.harness/runs/
.harness/runtime/
.harness/cache/
.harness/skills/
.skill-cache/
.harness-skills/
.harness-context/

# build output
dist
*.tsbuildinfo

# test coverage reports
coverage
